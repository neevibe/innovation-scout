# ---------------------------------------------------------------------------
# AI Innovation Scout — environment configuration
# Copy to .env.local. The app runs fully WITHOUT any of these (offline mode).
# Provide them to enable the LIVE intelligence pipeline (real web + LLM).
# ---------------------------------------------------------------------------

# Set to "live" to run the real Scout/Research/Contact agents against the web + an LLM.
# Any other value (or unset) runs the deterministic offline pipeline over seeded/collected data.
SCOUT_MODE=offline

# Vercel AI Gateway — used by the AI layer via plain "provider/model" strings.
# https://vercel.com/docs/ai-gateway
AI_GATEWAY_API_KEY=

# Default model for extraction / recommendation / scoring reasoning.
SCOUT_LLM_MODEL=anthropic/claude-sonnet-5

# Search/news provider for LIVE collection.
#   SCOUT_SEARCH_PROVIDER: tavily | gdelt | googlenews
#   - unset  -> tavily if TAVILY_API_KEY present, else googlenews (keyless dev default)
#   - tavily -> licensed, recommended for production (needs TAVILY_API_KEY)
#   - gdelt  -> keyless, programmatic-use-friendly (may be network-restricted)
#   - googlenews -> keyless DEV/DEMO ONLY (RSS ToS restricts non-feed-reader use)
SCOUT_SEARCH_PROVIDER=
TAVILY_API_KEY=

# Production database (swap the JSON store for Postgres via Vercel Marketplace / Neon).
DATABASE_URL=
