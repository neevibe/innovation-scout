{
  "rewrites": [
    {
      "source": "/",
      "destination": "/scout-globe/index.html"
    },
    {
      "source": "/support.js",
      "destination": "/scout-globe/support.js"
    },
    {
      "source": "/image-slot.js",
      "destination": "/scout-globe/image-slot.js"
    },
    {
      "source": "/scout",
      "destination": "/prototype/index.html"
    },
    {
      "source": "/scout/(.*)",
      "destination": "/prototype/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/freshness",
      "schedule": "0 1 * * *"
    }
  ]
}